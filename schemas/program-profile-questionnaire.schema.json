{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate.local/schemas/program-profile-questionnaire.schema.json",
  "title": "GATE program profile questionnaire contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "apiVersion", "kind", "metadata", "interaction", "semantics", "sections", "conditionalModules"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "apiVersion": { "const": "gate.dev/program-profile-questionnaire/v2" },
    "kind": { "const": "ProgramProfileQuestionnaire" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version", "description"],
      "properties": {
        "id": { "const": "bug-bounty-program-profile" },
        "title": { "$ref": "#/$defs/oneLine" },
        "version": { "type": "integer", "minimum": 1 },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "preferredSurface",
        "deriveBeforeAsk",
        "maxQuestionsPerBatch",
        "maxChoicesPerQuestion",
        "recommendation",
        "freeText",
        "structuredAnswers"
      ],
      "properties": {
        "style": { "const": "choice-first" },
        "preferredSurface": { "const": "native-choice-controls" },
        "deriveBeforeAsk": { "const": true },
        "maxQuestionsPerBatch": { "const": 3 },
        "maxChoicesPerQuestion": { "const": 3 },
        "recommendation": { "const": "best-supported-first" },
        "freeText": { "const": "short-exact-or-unrepresentable-only" },
        "structuredAnswers": { "const": "draft-review-or-decomposed-choices" }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispositions", "claimStates", "actions", "assistanceModes", "stopConditions", "coverageDomains", "moduleIds"],
      "properties": {
        "dispositions": { "$ref": "#/$defs/stringList" },
        "claimStates": { "$ref": "#/$defs/stringList" },
        "actions": { "$ref": "#/$defs/stringList" },
        "assistanceModes": { "$ref": "#/$defs/stringList" },
        "stopConditions": { "$ref": "#/$defs/stringList" },
        "coverageDomains": { "$ref": "#/$defs/stringList" },
        "moduleIds": { "$ref": "#/$defs/stringList" }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/section" }
    },
    "conditionalModules": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "oneLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/oneLine" }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "includes": { "$ref": "#/$defs/oneLine" },
        "equals": {}
      }
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z][A-Za-z0-9-]*)*$",
      "maxLength": 300
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "prompt", "why", "type", "required", "sensitive", "recommendationPolicy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
        "path": { "$ref": "#/$defs/path" },
        "prompt": { "$ref": "#/$defs/oneLine" },
        "why": { "$ref": "#/$defs/text" },
        "type": {
          "enum": [
            "text",
            "multiline",
            "boolean",
            "integer",
            "number",
            "datetime",
            "enum",
            "multi-enum",
            "decision",
            "source-list",
            "selector-decisions",
            "action-decisions",
            "coverage-decisions",
            "stop-responses",
            "secret-ref-list",
            "contact-list",
            "schedule-windows",
            "structured-list"
          ]
        },
        "required": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "allowNull": { "type": "boolean" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/oneLine" }
        },
        "condition": { "$ref": "#/$defs/condition" },
        "recommendationPolicy": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["class", "summary", "basis", "value"],
              "properties": {
                "class": { "const": "operator-preference" },
                "summary": { "$ref": "#/$defs/oneLine" },
                "basis": { "$ref": "#/$defs/oneLine" },
                "value": true
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["class", "summary", "proposalBasis"],
              "properties": {
                "class": { "const": "evidence-proposal" },
                "summary": { "$ref": "#/$defs/oneLine" },
                "proposalBasis": { "enum": ["source-required", "source-or-local"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["class", "summary"],
              "properties": {
                "class": { "const": "manual-only" },
                "summary": { "$ref": "#/$defs/oneLine" }
              }
            }
          ]
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "required", "questions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "title": { "$ref": "#/$defs/oneLine" },
        "purpose": { "$ref": "#/$defs/text" },
        "required": { "const": true },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "activation", "questions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "title": { "$ref": "#/$defs/oneLine" },
        "purpose": { "$ref": "#/$defs/text" },
        "activation": { "$ref": "#/$defs/condition" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    }
  }
}
