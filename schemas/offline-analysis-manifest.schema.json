{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate.local/schemas/offline-analysis-manifest.schema.json",
  "title": "GATE offline analysis manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "apiVersion", "kind", "metadata", "project", "operation", "networkPolicy", "limits", "runtime", "enforcement", "manifestSha256"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "apiVersion": { "const": "gate.offline-analysis/v1" },
    "kind": { "const": "OfflineAnalysisManifest" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "createdAt", "expiresAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^amf_[a-f0-9]{32}$" },
        "runId": { "type": "string", "pattern": "^arun_[a-f0-9]{32}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contractSha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "contractSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "targetSelector", "artifact", "adapter"],
      "properties": {
        "action": { "const": "local-static-analysis" },
        "targetSelector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "path" },
            "value": { "$ref": "#/$defs/path" }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshotRef", "sha256", "bytes", "sourceIdentity"],
          "properties": {
            "snapshotRef": { "type": "string", "pattern": "^private://offline-analysis/inputs/arun_[a-f0-9]{32}\\.bin$" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
            "sourceIdentity": { "$ref": "#/$defs/fileIdentityNoHash" }
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "toolId", "upstream", "arguments"],
          "properties": {
            "id": { "const": "rea-inspect-pe-resources-v1" },
            "toolId": { "const": "rea" },
            "upstream": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version", "commit", "packageIntegrity", "lockSha256"],
              "properties": {
                "id": { "const": "rea-stable" },
                "version": { "type": "string", "minLength": 1, "maxLength": 80 },
                "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
                "packageIntegrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
                "lockSha256": { "$ref": "#/$defs/sha256" }
              }
            },
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxFileBytes", "maxEntries", "format", "fullOutput"],
              "properties": {
                "maxFileBytes": { "const": 536870912 },
                "maxEntries": { "const": 16384 },
                "format": { "const": "json" },
                "fullOutput": { "const": true }
              }
            }
          }
        }
      }
    },
    "networkPolicy": { "const": "none" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxMinutes", "maxRequests", "maxRatePerSecond", "maxParallel", "maxTokens"],
      "properties": {
        "maxMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "maxRequests": { "const": 0 },
        "maxRatePerSecond": { "const": 0 },
        "maxParallel": { "const": 1 },
        "maxTokens": { "const": 0 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "platform", "uid", "gid", "environment", "sandboxRef", "evidence", "maxEvidenceBytesPerStream", "bwrap", "node", "adapter", "reaEntry", "logicalMounts"],
      "properties": {
        "mode": { "const": "bubblewrap-offline" },
        "platform": { "const": "linux" },
        "uid": { "type": "integer", "minimum": 0 },
        "gid": { "type": "integer", "minimum": 0 },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["HOME", "TMPDIR", "PATH", "LANG", "LC_ALL", "TZ", "TERM", "NO_COLOR"],
          "properties": {
            "HOME": { "const": "/home/gate" },
            "TMPDIR": { "const": "/tmp" },
            "PATH": { "const": "/opt/gate/node:/usr/bin:/bin" },
            "LANG": { "const": "C.UTF-8" },
            "LC_ALL": { "const": "C.UTF-8" },
            "TZ": { "const": "UTC" },
            "TERM": { "const": "dumb" },
            "NO_COLOR": { "const": "1" }
          }
        },
        "sandboxRef": { "type": "string", "pattern": "^private://offline-analysis/sandboxes/arun_[a-f0-9]{32}$" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stdoutRef", "stderrRef", "resultRef"],
          "properties": {
            "stdoutRef": { "$ref": "#/$defs/evidenceRef" },
            "stderrRef": { "$ref": "#/$defs/evidenceRef" },
            "resultRef": { "$ref": "#/$defs/evidenceRef" }
          }
        },
        "maxEvidenceBytesPerStream": { "const": 67108864 },
        "bwrap": { "$ref": "#/$defs/fileIdentity" },
        "node": { "$ref": "#/$defs/fileIdentity" },
        "adapter": { "$ref": "#/$defs/fileIdentity" },
        "reaEntry": { "$ref": "#/$defs/fileIdentity" },
        "logicalMounts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "destination", "mode"],
            "properties": {
              "source": { "enum": ["host-usr", "artifact-snapshot-fd", "node-directory-fd", "rea-directory-fd", "adapter-file-fd"] },
              "destination": { "enum": ["/usr", "/input/artifact", "/opt/gate/node", "/opt/gate/rea", "/opt/gate/adapter.mjs"] },
              "mode": { "const": "read-only" }
            }
          }
        }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforced", "unavailable"],
      "properties": {
        "enforced": { "$ref": "#/$defs/controlList" },
        "unavailable": { "$ref": "#/$defs/controlList" }
      }
    },
    "manifestSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000\\r\\n]*$" },
    "fileIdentityNoHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "device", "inode", "mtimeNs", "ctimeNs"],
      "properties": {
        "size": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "device": { "type": "string", "pattern": "^-?[0-9]+$" },
        "inode": { "type": "string", "pattern": "^-?[0-9]+$" },
        "mtimeNs": { "type": "string", "pattern": "^-?[0-9]+$" },
        "ctimeNs": { "type": "string", "pattern": "^-?[0-9]+$" }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "device", "inode", "mtimeNs", "ctimeNs"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "device": { "type": "string", "pattern": "^-?[0-9]+$" },
        "inode": { "type": "string", "pattern": "^-?[0-9]+$" },
        "mtimeNs": { "type": "string", "pattern": "^-?[0-9]+$" },
        "ctimeNs": { "type": "string", "pattern": "^-?[0-9]+$" }
      }
    },
    "evidenceRef": { "type": "string", "pattern": "^private://evidence/offline-analysis-arun_[a-f0-9]{32}-(?:stdout\\.json|stderr\\.bin|result\\.json)$" },
    "controlList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,80}$" }
    }
  }
}
