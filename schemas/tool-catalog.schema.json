{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate.local/schemas/tool-catalog.schema.json",
  "title": "GATE security tool catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "apiVersion",
    "kind",
    "policy",
    "tools"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "const": "gate.dev/catalog/v1"
    },
    "kind": {
      "const": "SecurityToolCatalog"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availabilityMeans",
        "defaultInstallMode",
        "pinRequired",
        "checksumRequiredWhenPublished",
        "telemetryDefault",
        "untrustedOutput"
      ],
      "properties": {
        "availabilityMeans": {
          "const": "candidate-metadata-for-reviewed-admission"
        },
        "defaultInstallMode": {
          "const": "on-demand"
        },
        "pinRequired": {
          "const": true
        },
        "checksumRequiredWhenPublished": {
          "const": true
        },
        "telemetryDefault": {
          "const": "off"
        },
        "untrustedOutput": {
          "const": true
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 55,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "riskClass",
        "approval",
        "license",
        "openSource",
        "upstream",
        "command",
        "installLanes",
        "supportedHosts",
        "privileges",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "enum": [
            "web-api",
            "network",
            "identity",
            "exploitation",
            "reverse-engineering",
            "mobile",
            "dfir",
            "osint",
            "cloud",
            "container-kubernetes",
            "source-security",
            "wireless-radio",
            "ai-systems",
            "compatibility"
          ]
        },
        "riskClass": {
          "enum": [
            "P0",
            "P1",
            "A1",
            "A2",
            "A3"
          ]
        },
        "approval": {
          "enum": [
            "automatic",
            "declared-source",
            "engagement",
            "no-mistakes",
            "operator-receipt"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "openSource": {
          "type": "boolean"
        },
        "upstream": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "command": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]+$",
          "minLength": 1,
          "maxLength": 80
        },
        "commandIdentity": {
          "$ref": "#/$defs/commandIdentity"
        },
        "managedAdapters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/managedAdapter"
          }
        },
        "dataDependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dataDependency"
          }
        },
        "installLanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "native-os",
              "pinned-release",
              "isolated-python",
              "isolated-node",
              "java-archive",
              "oci",
              "source-build",
              "hardware",
              "external-user-install"
            ]
          }
        },
        "supportedHosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "linux",
              "macos",
              "windows",
              "wsl2"
            ]
          }
        },
        "privileges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "user",
              "admin",
              "capture",
              "raw-network",
              "certificate-store",
              "debug",
              "device",
              "gpu",
              "kernel",
              "service",
              "cloud-read",
              "cloud-write"
            ]
          }
        },
        "notes": {
          "type": "string",
          "minLength": 20,
          "maxLength": 600
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "riskClass": {
                "const": "P0"
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "automatic"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "riskClass": {
                "const": "P1"
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "declared-source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "riskClass": {
                "const": "A1"
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "engagement"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "riskClass": {
                "const": "A2"
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "no-mistakes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "riskClass": {
                "const": "A3"
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "operator-receipt"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "commandIdentity": {
                "properties": {
                  "pathDiscovery": {
                    "const": "ambiguous-command-name"
                  }
                },
                "required": [
                  "pathDiscovery"
                ]
              }
            },
            "required": [
              "commandIdentity"
            ]
          },
          "then": {
            "properties": {
              "commandIdentity": {
                "properties": {
                  "genericLaneAdmission": {
                    "const": "reviewed-admission"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "managedAdapters": {}
            },
            "required": [
              "managedAdapters"
            ]
          },
          "then": {
            "required": [
              "commandIdentity"
            ],
            "properties": {
              "commandIdentity": {
                "properties": {
                  "genericLaneAdmission": {
                    "const": "reviewed-admission"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "riskClass": {
                    "const": "A3"
                  }
                },
                "required": [
                  "riskClass"
                ]
              },
              {
                "properties": {
                  "dataDependencies": {}
                },
                "required": [
                  "dataDependencies"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "commandIdentity": {
                "properties": {
                  "genericLaneAdmission": {
                    "const": "reviewed-admission"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "httpx"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "required": [
              "commandIdentity"
            ],
            "properties": {
              "commandIdentity": {
                "properties": {
                  "pathDiscovery": {
                    "const": "ambiguous-command-name"
                  },
                  "genericLaneAdmission": {
                    "const": "reviewed-admission"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "rea"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "required": [
              "commandIdentity",
              "managedAdapters"
            ],
            "properties": {
              "commandIdentity": {
                "properties": {
                  "genericLaneAdmission": {
                    "const": "reviewed-admission"
                  }
                }
              },
              "managedAdapters": {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "rea-inspect-pe-resources-v1"
                    },
                    "mode": {
                      "const": "offline-static-pe-resources"
                    },
                    "upstreamId": {
                      "const": "rea-stable"
                    },
                    "binary": {
                      "const": "rea"
                    },
                    "upstreamEntrypoint": {
                      "const": "node_modules/rea-agents/scripts/rea.mjs"
                    },
                    "entrypoint": {
                      "const": "src/adapters/rea-pe-resources.mjs"
                    },
                    "sandboxCommand": {
                      "const": "bwrap"
                    },
                    "supportedHosts": {
                      "const": [
                        "linux"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "mode",
                    "upstreamId",
                    "binary",
                    "upstreamEntrypoint",
                    "entrypoint",
                    "sandboxCommand",
                    "supportedHosts"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        }
      ]
    },
    "commandIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pathDiscovery",
        "genericLaneAdmission",
        "reason"
      ],
      "properties": {
        "pathDiscovery": {
          "enum": [
            "command-name",
            "ambiguous-command-name"
          ]
        },
        "genericLaneAdmission": {
          "enum": [
            "path-discovery",
            "reviewed-admission"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300
        }
      }
    },
    "dataDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "pinPolicy",
        "requiredFor",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "benchmark",
            "browser-runtime",
            "collector",
            "corpus",
            "database",
            "feed",
            "ruleset",
            "symbol-pack",
            "system-image",
            "template-pack",
            "wordlist"
          ]
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "pinPolicy": {
          "enum": [
            "full-commit-and-tree-digest",
            "oci-digest",
            "snapshot-and-sha256",
            "version-and-sha256"
          ]
        },
        "requiredFor": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "notes": {
          "type": "string",
          "minLength": 20,
          "maxLength": 400
        }
      }
    },
    "managedAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "upstreamId",
        "binary",
        "upstreamEntrypoint",
        "entrypoint",
        "sandboxCommand",
        "supportedHosts",
        "capability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 64
        },
        "mode": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 80
        },
        "upstreamId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 64
        },
        "binary": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]+$",
          "minLength": 1,
          "maxLength": 80
        },
        "upstreamEntrypoint": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._+/-]+$",
          "minLength": 3,
          "maxLength": 240
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._+/-]+$",
          "minLength": 3,
          "maxLength": 240
        },
        "sandboxCommand": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]+$",
          "minLength": 1,
          "maxLength": 80
        },
        "supportedHosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "linux",
              "macos",
              "windows",
              "wsl2"
            ]
          }
        },
        "capability": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300
        }
      }
    }
  }
}
