{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate.local/schemas/tool-catalog.schema.json",
  "title": "GATE security tool catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "apiVersion",
    "kind",
    "policy",
    "tools"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "const": "gate.dev/catalog/v1"
    },
    "kind": {
      "const": "SecurityToolCatalog"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availabilityMeans",
        "defaultInstallMode",
        "pinRequired",
        "checksumRequiredWhenPublished",
        "telemetryDefault",
        "untrustedOutput"
      ],
      "properties": {
        "availabilityMeans": {
          "const": "discoverable-and-reproducibly-installable"
        },
        "defaultInstallMode": {
          "const": "on-demand"
        },
        "pinRequired": {
          "const": true
        },
        "checksumRequiredWhenPublished": {
          "const": true
        },
        "telemetryDefault": {
          "const": "off"
        },
        "untrustedOutput": {
          "const": true
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 55,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "riskClass",
        "approval",
        "license",
        "openSource",
        "upstream",
        "command",
        "installLanes",
        "supportedHosts",
        "privileges",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "enum": [
            "web-api",
            "network",
            "identity",
            "exploitation",
            "reverse-engineering",
            "mobile",
            "dfir",
            "osint",
            "cloud",
            "container-kubernetes",
            "source-security",
            "wireless-radio",
            "compatibility"
          ]
        },
        "riskClass": {
          "enum": [
            "P0",
            "P1",
            "A1",
            "A2",
            "A3"
          ]
        },
        "approval": {
          "enum": [
            "automatic",
            "declared-source",
            "engagement",
            "no-mistakes",
            "operator-receipt"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "openSource": {
          "type": "boolean"
        },
        "upstream": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "command": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]+$",
          "minLength": 1,
          "maxLength": 80
        },
        "installLanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "native-os",
              "pinned-release",
              "isolated-python",
              "isolated-node",
              "java-archive",
              "oci",
              "source-build",
              "hardware",
              "external-user-install"
            ]
          }
        },
        "supportedHosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "linux",
              "macos",
              "windows",
              "wsl2"
            ]
          }
        },
        "privileges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "user",
              "admin",
              "capture",
              "raw-network",
              "certificate-store",
              "debug",
              "device",
              "gpu",
              "kernel",
              "service",
              "cloud-read",
              "cloud-write"
            ]
          }
        },
        "notes": {
          "type": "string",
          "minLength": 20,
          "maxLength": 600
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "riskClass": {
                "const": "P0"
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "automatic"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "riskClass": {
                "const": "P1"
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "declared-source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "riskClass": {
                "const": "A1"
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "engagement"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "riskClass": {
                "const": "A2"
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "no-mistakes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "riskClass": {
                "const": "A3"
              }
            },
            "required": [
              "riskClass"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "operator-receipt"
              }
            }
          }
        }
      ]
    }
  }
}
