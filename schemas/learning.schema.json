{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate.local/schemas/learning.schema.json",
  "title": "GATE learning record",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "at", "scope", "cause", "change", "evidence", "status", "sensitivity", "supersedes", "configurationRefs"],
  "properties": {
    "apiVersion": { "const": "gate.learning/v1" },
    "id": { "type": "string", "pattern": "^lrn_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$" },
    "at": { "type": "string", "format": "date-time" },
    "scope": { "enum": ["session", "project", "repository"] },
    "cause": { "$ref": "#/$defs/oneLine" },
    "change": { "$ref": "#/$defs/oneLine" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(event|evidence|private|commit)://[^\\s]+$" }
    },
    "status": { "enum": ["proposed", "active", "superseded", "reverted"] },
    "sensitivity": { "enum": ["public", "private"] },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^lrn_[A-Za-z0-9][A-Za-z0-9_-]{5,127}$"
    },
    "configurationRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$" }
    }
  },
  "$defs": {
    "oneLine": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n]+$" }
  }
}
