{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate.local/schemas/bug-bounty-program-profile.schema.json",
  "title": "GATE private bug bounty program profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "apiVersion",
    "kind",
    "metadata",
    "questionnaire",
    "identity",
    "sources",
    "authorization",
    "scope",
    "techniquePolicy",
    "executionPolicy",
    "limits",
    "access",
    "architecture",
    "coverage",
    "dataEvidence",
    "stops",
    "reporting",
    "modules",
    "ambiguities",
    "attestation"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "const": "gate.dev/program-profile/v1"
    },
    "kind": {
      "const": "BugBountyProgramProfile"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "owner",
        "status",
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/oneLine"
        },
        "owner": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "draft",
            "needs-operator-review",
            "ready-to-materialize",
            "superseded"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "questionnaire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectionStatus",
        "applicableModules",
        "activeSection"
      ],
      "properties": {
        "sectionStatus": {
          "$ref": "#/$defs/sectionStatus"
        },
        "applicableModules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/moduleId"
          }
        },
        "activeSection": {
          "oneOf": [
            {
              "$ref": "#/$defs/sectionId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programName",
        "objective",
        "depth",
        "deliverables",
        "successCriteria"
      ],
      "properties": {
        "programName": {
          "$ref": "#/$defs/oneLine"
        },
        "objective": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "depth": {
          "enum": [
            "targeted",
            "thorough",
            "exhaustive"
          ]
        },
        "deliverables": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "successCriteria": {
          "$ref": "#/$defs/nonEmptyStringList"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "programUrl",
        "safeHarbor",
        "validFrom",
        "validUntil",
        "lastVerifiedAt",
        "sourceRefs",
        "operatorConfirmed",
        "contacts"
      ],
      "properties": {
        "basis": {
          "enum": [
            "owner",
            "client-written-authorization",
            "contract",
            "public-bug-bounty-program",
            "dedicated-lab"
          ]
        },
        "programUrl": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "safeHarbor": {
          "$ref": "#/$defs/decision"
        },
        "validFrom": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "validUntil": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastVerifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "operatorConfirmed": {
          "type": "boolean"
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contact"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets",
        "thirdPartyHandling",
        "redirectHandling",
        "discoveredAssetHandling"
      ],
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assetDecision"
          }
        },
        "thirdPartyHandling": {
          "$ref": "#/$defs/decision"
        },
        "redirectHandling": {
          "$ref": "#/$defs/decision"
        },
        "discoveredAssetHandling": {
          "$ref": "#/$defs/decision"
        }
      }
    },
    "techniquePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "techniques"
      ],
      "properties": {
        "actions": {
          "$ref": "#/$defs/actionMatrix"
        },
        "techniques": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/techniqueDecision"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "windows",
        "maxMinutes",
        "maxRequests",
        "maxParallel",
        "maxRatePerSecond",
        "maxTokens",
        "maxSpendUsd",
        "sourceRefs"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\r\\n]+$"
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scheduleWindow"
          }
        },
        "maxMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        },
        "maxRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxParallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "maxRatePerSecond": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000000
        },
        "maxSpendUsd": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ],
          "description": "External-spend ceiling in USD. Zero explicitly prohibits spending; null explicitly records that no monetary ceiling was supplied."
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accounts",
        "identityProviderNotes"
      ],
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/account"
          }
        },
        "identityProviderNotes": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyText"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "trustBoundaries",
        "dataFlows",
        "unknowns",
        "sourceRefs"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/architectureComponent"
          }
        },
        "trustBoundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trustBoundary"
          }
        },
        "dataFlows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataFlow"
          }
        },
        "unknowns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/oneLine"
          }
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverageMatrix"
    },
    "dataEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "allowedDestinations",
        "retentionDays",
        "redactionRules",
        "minimumProof",
        "secretRefs",
        "sourceRefs"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "allowedDestinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "gate-home",
              "configured-cloud-model",
              "client-destination"
            ]
          }
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "redactionRules": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "minimumProof": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "secretRefs": {
          "$ref": "#/$defs/secretRefs"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "stops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditions",
        "escalationContacts",
        "cleanup"
      ],
      "properties": {
        "conditions": {
          "$ref": "#/$defs/stopMatrix"
        },
        "escalationContacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contact"
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "steps",
            "verification",
            "sourceRefs"
          ],
          "properties": {
            "required": {
              "const": true
            },
            "steps": {
              "$ref": "#/$defs/nonEmptyStringList"
            },
            "verification": {
              "$ref": "#/$defs/nonEmptyText"
            },
            "sourceRefs": {
              "$ref": "#/$defs/sourceRefs"
            }
          }
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severityStandard",
        "submissionChannel",
        "disclosurePolicy",
        "retestPolicy",
        "requiredSections",
        "sourceRefs"
      ],
      "properties": {
        "severityStandard": {
          "$ref": "#/$defs/oneLine"
        },
        "submissionChannel": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "disclosurePolicy": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "retestPolicy": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "requiredSections": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "modules": {
      "$ref": "#/$defs/moduleMatrix"
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguity"
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "answersComplete",
        "sourceClaimsReviewed",
        "exactScopeReviewed",
        "attestedAt",
        "attestedRevision"
      ],
      "properties": {
        "operator": {
          "$ref": "#/$defs/id"
        },
        "answersComplete": {
          "type": "boolean"
        },
        "sourceClaimsReviewed": {
          "type": "boolean"
        },
        "exactScopeReviewed": {
          "type": "boolean"
        },
        "attestedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "attestedRevision": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "executionPolicy": {
      "$ref": "#/$defs/executionPolicy"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "oneLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n]+$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "claimState": {
      "enum": [
        "observed",
        "inferred",
        "unverified"
      ]
    },
    "disposition": {
      "enum": [
        "allowed",
        "denied",
        "conditional",
        "unknown"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "secretRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(env|keychain|file)://[^\\s]+$"
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyText"
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "claimState",
        "sourceRefs",
        "rationale",
        "conditions"
      ],
      "properties": {
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "claimState": {
          "$ref": "#/$defs/claimState"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "rationale": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyText"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyText"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "conditional"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "conditions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "unknown"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "claimState": {
                "const": "unverified"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "reference",
        "contentSha256",
        "observedAt",
        "claimState",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "operator-statement",
            "program-rules",
            "safe-harbor",
            "scope-list",
            "contract",
            "platform-page",
            "architecture",
            "account-instructions",
            "other"
          ]
        },
        "title": {
          "$ref": "#/$defs/oneLine"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\s]+$"
        },
        "contentSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "claimState": {
          "$ref": "#/$defs/claimState"
        },
        "notes": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyText"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "channel",
        "purpose",
        "sourceRefs"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/oneLine"
        },
        "role": {
          "$ref": "#/$defs/oneLine"
        },
        "channel": {
          "$ref": "#/$defs/oneLine"
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "domain",
            "ip",
            "cidr",
            "url",
            "application",
            "account",
            "repository",
            "device",
            "path"
          ]
        },
        "value": {
          "$ref": "#/$defs/oneLine"
        }
      }
    },
    "assetDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "selector",
        "disposition",
        "claimState",
        "sourceRefs",
        "rationale",
        "conditions",
        "actionOverrides",
        "limitOverrides"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "claimState": {
          "$ref": "#/$defs/claimState"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "rationale": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyText"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyText"
          }
        },
        "actionOverrides": {
          "$ref": "#/$defs/partialActionMatrix"
        },
        "limitOverrides": {
          "$ref": "#/$defs/partialExecutionLimits"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "conditional"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "conditions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "unknown"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "claimState": {
                "const": "unverified"
              }
            }
          }
        }
      ]
    },
    "action": {
      "enum": [
        "observe",
        "scan",
        "intercept",
        "authenticate",
        "fuzz",
        "exploit-safe",
        "exploit-stateful",
        "persist",
        "denial-of-service",
        "destructive-test",
        "data-access",
        "data-removal",
        "exfiltration-simulation"
      ]
    },
    "actionMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observe",
        "scan",
        "intercept",
        "authenticate",
        "fuzz",
        "exploit-safe",
        "exploit-stateful",
        "persist",
        "denial-of-service",
        "destructive-test",
        "data-access",
        "data-removal",
        "exfiltration-simulation"
      ],
      "properties": {
        "observe": {
          "$ref": "#/$defs/decision"
        },
        "scan": {
          "$ref": "#/$defs/decision"
        },
        "intercept": {
          "$ref": "#/$defs/decision"
        },
        "authenticate": {
          "$ref": "#/$defs/decision"
        },
        "fuzz": {
          "$ref": "#/$defs/decision"
        },
        "exploit-safe": {
          "$ref": "#/$defs/decision"
        },
        "exploit-stateful": {
          "$ref": "#/$defs/decision"
        },
        "persist": {
          "$ref": "#/$defs/decision"
        },
        "denial-of-service": {
          "$ref": "#/$defs/decision"
        },
        "destructive-test": {
          "$ref": "#/$defs/decision"
        },
        "data-access": {
          "$ref": "#/$defs/decision"
        },
        "data-removal": {
          "$ref": "#/$defs/decision"
        },
        "exfiltration-simulation": {
          "$ref": "#/$defs/decision"
        }
      }
    },
    "techniqueDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "action",
        "disposition",
        "claimState",
        "sourceRefs",
        "rationale",
        "conditions",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/oneLine"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "claimState": {
          "$ref": "#/$defs/claimState"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "rationale": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyText"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyText"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
