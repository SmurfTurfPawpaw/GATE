{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate.local/schemas/workflow-handoff.schema.json",
  "title": "GATE structured workflow phase handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "apiVersion",
    "kind",
    "instanceId",
    "workflowDefinitionSha256",
    "handoffId",
    "policyId",
    "type",
    "fromPhase",
    "toPhase",
    "sourceAttemptId",
    "hypothesis",
    "target",
    "action",
    "toolId",
    "toolMappingSha256",
    "adapterConstraint",
    "admissionSha256",
    "authority",
    "envelope",
    "scopeDelta",
    "priorEvidence",
    "proofCeiling",
    "stateChangePlan",
    "mandatoryStopConditions",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "apiVersion": { "const": "gate.workflow-handoff/v1" },
    "kind": { "const": "WorkflowHandoff" },
    "instanceId": { "$ref": "#/$defs/instanceId" },
    "workflowDefinitionSha256": { "$ref": "#/$defs/sha256" },
    "handoffId": { "$ref": "#/$defs/phaseId" },
    "policyId": { "$ref": "#/$defs/phaseId" },
    "type": { "enum": ["approval-boundary", "operational-transfer"] },
    "fromPhase": { "$ref": "#/$defs/phaseId" },
    "toPhase": { "$ref": "#/$defs/phaseId" },
    "sourceAttemptId": { "type": "string", "pattern": "^wpa_[a-f0-9]{32}$" },
    "hypothesis": { "$ref": "#/$defs/oneLine" },
    "target": { "$ref": "#/$defs/oneLine" },
    "action": { "$ref": "#/$defs/action" },
    "toolId": { "$ref": "#/$defs/toolId" },
    "toolMappingSha256": { "$ref": "#/$defs/sha256" },
    "adapterConstraint": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "admissionSha256": { "$ref": "#/$defs/sha256" },
    "authority": { "$ref": "#/$defs/authority" },
    "envelope": { "$ref": "#/$defs/envelope" },
    "scopeDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changes", "justification"],
      "properties": {
        "changes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "target",
              "action",
              "tool",
              "environment",
              "limit",
              "exclusion",
              "data-destination",
              "authority-window",
              "none"
            ]
          }
        },
        "justification": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000,
          "pattern": "^[^\\u0000\\r\\n]+$"
        }
      }
    },
    "priorEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "sha256", "claimState"],
        "properties": {
          "evidenceId": { "$ref": "#/$defs/phaseId" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "claimState": { "enum": ["observed", "inferred"] }
        }
      }
    },
    "proofCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectClass", "capability", "successCondition", "prohibitedEffects"],
      "properties": {
        "effectClass": { "const": "A3" },
        "capability": { "$ref": "#/$defs/oneLine" },
        "successCondition": { "$ref": "#/$defs/oneLine" },
        "prohibitedEffects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/oneLine" }
        }
      }
    },
    "stateChangePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerRef",
        "plannedChanges",
        "cleanupActions",
        "monitoringOwner",
        "abortCondition",
        "residualStateAction"
      ],
      "properties": {
        "ledgerRef": { "const": "engagement-state-change-ledger" },
        "plannedChanges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/oneLine" }
        },
        "cleanupActions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/oneLine" }
        },
        "monitoringOwner": { "$ref": "#/$defs/oneLine" },
        "abortCondition": { "$ref": "#/$defs/oneLine" },
        "residualStateAction": { "$ref": "#/$defs/oneLine" }
      }
    },
    "mandatoryStopConditions": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "enum": [
          "scope-mismatch",
          "plan-digest-change",
          "authorization-expiry",
          "unexpected-data-loss",
          "target-instability",
          "third-party-system-discovered",
          "rate-limit-exceeded",
          "evidence-integrity-failure",
          "operator-stop",
          "unexpected-sensitive-data",
          "unplanned-privilege-or-persistence",
          "defensive-control-impact",
          "cleanup-incomplete"
        ]
      }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "instanceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "phaseId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "toolId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "oneLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "action": {
      "enum": [
        "observe",
        "scan",
        "intercept",
        "authenticate",
        "fuzz",
        "exploit-safe",
        "exploit-stateful",
        "persist",
        "denial-of-service",
        "destructive-test",
        "data-access",
        "data-removal",
        "exfiltration-simulation"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engagementId",
        "planSha256",
        "envelopeSha256",
        "receiptSha256",
        "authorizationValidUntil",
        "checkedAt"
      ],
      "properties": {
        "engagementId": { "$ref": "#/$defs/instanceId" },
        "planSha256": { "$ref": "#/$defs/sha256" },
        "envelopeSha256": { "$ref": "#/$defs/sha256" },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "authorizationValidUntil": { "type": "string", "format": "date-time" },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "controlState": {
      "enum": ["enforced", "measured-only", "unavailable"]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxMinutes",
        "maxRequests",
        "maxRatePerSecond",
        "maxParallel",
        "maxInputTokens",
        "maxOutputTokens",
        "maxTotalTokens",
        "maxEvidenceBytes",
        "maxSpend",
        "controls"
      ],
      "properties": {
        "maxMinutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
        "maxRequests": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maxRatePerSecond": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxInputTokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "maxOutputTokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "maxTotalTokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "maxEvidenceBytes": { "type": "integer", "minimum": 1048576, "maximum": 2147483648 },
        "maxSpend": { "type": "number", "minimum": 0, "maximum": 1000000000 },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wallTime", "requests", "rate", "parallel", "tokens", "evidenceBytes", "spend"],
          "properties": {
            "wallTime": { "$ref": "#/$defs/controlState" },
            "requests": { "$ref": "#/$defs/controlState" },
            "rate": { "$ref": "#/$defs/controlState" },
            "parallel": { "$ref": "#/$defs/controlState" },
            "tokens": { "$ref": "#/$defs/controlState" },
            "evidenceBytes": { "$ref": "#/$defs/controlState" },
            "spend": { "$ref": "#/$defs/controlState" }
          }
        }
      }
    }
  }
}
