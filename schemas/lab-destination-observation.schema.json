{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate.local/schemas/lab-destination-observation.schema.json",
  "title": "GATE reviewed dedicated-lab destination observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "apiVersion", "kind", "origin", "hostname", "ips", "observedAt", "source"],
  "properties": {
    "$schema": { "const": "https://gate.local/schemas/lab-destination-observation.schema.json" },
    "apiVersion": { "const": "gate.lab-destination-observation/v1" },
    "kind": { "const": "LabDestinationObservation" },
    "origin": { "type": "string", "format": "uri", "maxLength": 500 },
    "hostname": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9.:-]+$" },
    "ips": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 45, "pattern": "^[0-9a-fA-F:.]+$" }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "sha256"],
      "properties": {
        "kind": { "enum": ["dns-a-aaaa", "program-published", "operator-reviewed"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\u0000\\r\\n]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
