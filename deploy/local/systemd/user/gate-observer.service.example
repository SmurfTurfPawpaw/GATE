[Unit]
Description=GATE local read-only observer
Documentation=https://github.com/SmurfTurfPawpaw/GATE
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=%h/.config/gate/gate.env
Environment=GATE_CASE=
Environment=NODE_OPTIONS=
Environment=PATH=/usr/bin:/bin
WorkingDirectory=@GATE_WORKDIR@
ExecStart=@NODE@ @GATE_BIN@ up --host 127.0.0.1 --port 4173
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
