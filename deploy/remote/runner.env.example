GATE_REMOTE_CONTROL_PLANE=https://gate-case.example.test
GATE_REMOTE_CASE_ID=example-case
GATE_REMOTE_SESSION_REVISION=1
GATE_REMOTE_RUNNER_ID=runner-example-001
GATE_REMOTE_PRIVATE_KEY_FILE=/home/operator/.local/share/gate/remote/example-case/runner/runner-private.pem
GATE_REMOTE_JOURNAL_DIR=/home/operator/.local/share/gate/remote/example-case/runner
GATE_REMOTE_CODEX_HOME=/home/operator/.local/share/gate/remote/example-case/runner/codex-home
GATE_REMOTE_THREAD_ID_FILE=/home/operator/.local/share/gate/remote/example-case/runner/codex-thread.json
# The remote runner supports only its conversation-only read-only posture.
# Use a separate working directory for each concurrent case. It supplies only
# app-server configuration context; local filesystem and execution tools are disabled.
GATE_REPO=/home/operator/src/GATE-example-case
GATE_OBSERVER_URL=http://127.0.0.1:4173/api/status
