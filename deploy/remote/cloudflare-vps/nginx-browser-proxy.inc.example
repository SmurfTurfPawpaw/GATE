# Included only from the reviewed browser locations.
# Cloudflare Access supplies Cf-Access-Jwt-Assertion after interactive login.
if ($http_cf_access_jwt_assertion = "") { return 401; }

proxy_pass http://127.0.0.1:43180;
proxy_http_version 1.1;
proxy_pass_request_headers on;
proxy_request_buffering off;
proxy_buffering off;
proxy_cache off;
proxy_no_cache 1;
proxy_cache_bypass 1;
proxy_intercept_errors off;

# Replace public values; do not append or trust their client-supplied versions.
proxy_set_header Host REPLACE_PUBLIC_HOSTNAME;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header Connection "";
proxy_set_header X-GATE-OIDC-Assertion $http_cf_access_jwt_assertion;
proxy_set_header Cf-Access-Jwt-Assertion "";

# Runner authentication material is meaningless on a browser route.
proxy_set_header X-GATE-Runner "";
proxy_set_header X-GATE-Timestamp "";
proxy_set_header X-GATE-Nonce "";
proxy_set_header X-GATE-Body-SHA256 "";
proxy_set_header X-GATE-Signature "";

add_header Cache-Control "private, no-store, max-age=0" always;
add_header Pragma "no-cache" always;
add_header X-Accel-Buffering "no" always;
