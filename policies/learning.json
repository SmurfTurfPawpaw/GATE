{
  "$schema": "../schemas/learning-policy.schema.json",
  "apiVersion": "gate.dev/policy/v1",
  "kind": "LearningPolicy",
  "metadata": {
    "name": "continuous-evidence-backed-learning"
  },
  "triggers": [
    "operator-correction",
    "failed-action",
    "retry-or-workaround",
    "tool-gap",
    "better-tool-discovered",
    "policy-violation",
    "benchmark-regression",
    "evidence-contradiction",
    "unexpected-environment-constraint",
    "test-strategy-revision",
    "orchestration-method-revision"
  ],
  "record": {
    "requiredFields": ["at", "scope", "cause", "change", "evidence", "status", "sensitivity"],
    "onePhysicalLine": true,
    "causeAndChangeRequired": true,
    "secretsAllowed": false,
    "targetIdentifiersInPublicLog": false
  },
  "scopes": [
    {
      "id": "session",
      "automaticCapture": true,
      "promotionRequired": false,
      "destination": "private"
    },
    {
      "id": "project",
      "automaticCapture": true,
      "promotionRequired": true,
      "destination": "project"
    },
    {
      "id": "repository",
      "automaticCapture": true,
      "promotionRequired": true,
      "destination": "public-sanitized"
    }
  ],
  "promotion": {
    "owner": "no-mistakes",
    "requires": ["supporting-evidence", "deduplication", "redaction", "behavior-change", "validation", "review-attestation"],
    "allowedStatuses": ["proposed", "active", "superseded", "reverted"]
  },
  "consultation": {
    "activeOnly": true,
    "exactApplicability": true,
    "deterministic": true,
    "maxRecords": 8,
    "maxBytes": 4096,
    "conflictBehavior": "block",
    "hotReloadDuringAttempt": false
  },
  "testFeedback": {
    "destination": "private-workflow-journal",
    "hashChained": true,
    "reviewIsAdvisory": true,
    "routineResultsBecomeLearning": false,
    "nextAttemptRequiresExplicitPlan": true
  },
  "protectedBoundaries": [
    "target-scope",
    "authorization",
    "tool-selection",
    "execution-environment",
    "effect-class",
    "resource-limits",
    "stop-conditions",
    "secret-release",
    "data-destination",
    "publication-permission",
    "destructive-action-permission"
  ],
  "untrustedInput": {
    "mayPropose": true,
    "mayActivate": false,
    "mayDirectlyWritePersistentMemory": false,
    "mayChangePolicy": false,
    "mayLaunchTest": false
  }
}
