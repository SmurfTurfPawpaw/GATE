{
  "$schema": "../schemas/data-policy.schema.json",
  "apiVersion": "gate.dev/policy/v1",
  "kind": "DataPolicy",
  "metadata": {
    "name": "local-first-data"
  },
  "defaults": {
    "classification": "internal",
    "telemetry": "disabled",
    "lavishSharing": "local-only",
    "rawEvidenceLocation": "gate-home",
    "literalSecretsAllowed": false
  },
  "classifications": [
    {
      "id": "public",
      "cloudModel": "allow",
      "publicRepository": "allow-after-validation",
      "externalSharing": "allow-after-validation"
    },
    {
      "id": "internal",
      "cloudModel": "allow-configured-provider",
      "publicRepository": "require-explicit-release",
      "externalSharing": "require-explicit-release"
    },
    {
      "id": "sensitive",
      "cloudModel": "require-explicit-release",
      "publicRepository": "deny",
      "externalSharing": "require-explicit-release"
    },
    {
      "id": "secret",
      "cloudModel": "deny",
      "publicRepository": "deny",
      "externalSharing": "deny"
    }
  ],
  "alwaysSensitive": [
    "packet-captures",
    "private-case-records",
    "proprietary-binaries",
    "unpublished-findings",
    "client-material",
    "authentication-artifacts",
    "precise-personal-location"
  ],
  "alwaysSecret": [
    "passwords",
    "api-tokens",
    "private-keys",
    "session-cookies",
    "recovery-codes"
  ],
  "secretReferences": {
    "allowedSchemes": ["env", "keychain", "file"],
    "pattern": "^(env|keychain|file)://[^\\s]+$",
    "resolveOnlyAtExecution": true,
    "redactFromEvents": true
  },
  "evidence": {
    "rawData": "private-by-default",
    "derivedSummaries": "sanitize-before-publication",
    "hashRawArtifacts": true,
    "recordSourceAndTimestamp": true,
    "recordToolVersionAndCommand": true,
    "publicEvidenceRequiresExplicitRelease": true
  }
}
