{
  "$schema": "../schemas/engagement-policy.schema.json",
  "apiVersion": "gate.dev/policy/v1",
  "kind": "EngagementPolicy",
  "metadata": {
    "name": "evidence-led-active-security"
  },
  "actionClasses": [
    {
      "id": "local-analysis",
      "targetContact": false,
      "receiptRequired": false,
      "examples": ["local-static-analysis", "saved-capture-analysis", "binary-analysis"]
    },
    {
      "id": "research",
      "targetContact": false,
      "receiptRequired": false,
      "examples": ["public-source-research", "plan", "hypothesis"]
    },
    {
      "id": "probe",
      "targetContact": true,
      "receiptRequired": true,
      "examples": ["live-observe", "scan", "service-enumeration", "web-crawl", "fuzz"]
    },
    {
      "id": "mutate",
      "targetContact": true,
      "receiptRequired": true,
      "examples": ["authenticate", "intercept", "exploit-safe", "state-change"]
    },
    {
      "id": "high-impact",
      "targetContact": true,
      "receiptRequired": true,
      "examples": ["persistence", "denial-of-service", "destructive-test", "data-removal"]
    }
  ],
  "activeRequirements": [
    "authorization-evidence",
    "explicit-target-selectors",
    "scope-exclusions",
    "permitted-action-list",
    "permitted-tool-list",
    "bounded-plan",
    "no-mistakes-plan-review",
    "operator-plan-receipt",
    "matching-plan-digest",
    "reviewed-adapter-or-host-supervised-generic-manifest",
    "receipt-bound-gate-home-destination-for-supervised-generic",
    "exact-target-and-argv-binding",
    "declared-action-label-binding",
    "catalog-risk-class-binding",
    "argv-action-semantics-validation-unavailable",
    "supervisor-crash-containment-unavailable",
    "immutable-executable-snapshot-unavailable",
    "one-shot-execution-claim",
    "executable-descriptor-observed-sha256",
    "operator-execution-confirmation",
    "declared-bounds-within-receipt",
    "declared-request-rate-and-concurrency-bounds",
    "stop-conditions",
    "private-audit-log"
  ],
  "receiptInvalidators": [
    "plan-digest-change",
    "target-added",
    "action-class-added",
    "tool-added",
    "execution-environment-change",
    "authorization-expired",
    "limit-increased",
    "exclusion-removed",
    "data-destination-added"
  ],
  "mandatoryCoverage": [
    "asset-discovery",
    "architecture",
    "authentication",
    "authorization",
    "sessions",
    "inputs",
    "business-logic",
    "client-behavior",
    "data-exposure",
    "infrastructure",
    "supply-chain",
    "post-exploitation-impact"
  ],
  "claimStates": ["observed", "inferred", "unverified"],
  "completion": {
    "coverageMapRequired": true,
    "explicitLimitationsRequired": true,
    "independentFindingValidationRequired": true,
    "emptyScannerOutputIsSufficient": false,
    "uncoveredSurfaceIsSufficient": false
  },
  "defaultStopConditions": [
    "scope-mismatch",
    "plan-digest-change",
    "authorization-expiry",
    "unexpected-data-loss",
    "target-instability",
    "third-party-system-discovered",
    "rate-limit-exceeded",
    "evidence-integrity-failure",
    "operator-stop"
  ]
}
